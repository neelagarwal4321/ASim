# ─── LLM Provider ────────────────────────────────────────────────────────────
# "ollama" for local dev, "anthropic" for production
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Ollama (local testing)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ─── PostgreSQL — Supabase ────────────────────────────────────────────────────
# Python FastAPI uses asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:password@host:5432/postgres
# Node server uses standard pg driver (same DB, different driver prefix)
DATABASE_URL_NODE=postgresql://postgres:password@host:5432/postgres

# ─── MongoDB — Atlas (or local mongod) ───────────────────────────────────────
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/asim
MONGODB_DB=asim

# ─── Redis — Upstash ─────────────────────────────────────────────────────────
REDIS_URL=redis://default:password@host:port
CELERY_BROKER_URL=redis://default:password@host:port/0
CELERY_RESULT_BACKEND=redis://default:password@host:port/1

# ─── Server ports ────────────────────────────────────────────────────────────
NODE_PORT=3000          # Express API server (frontend-facing)
FASTAPI_PORT=8000       # FastAPI simulation engine (internal only)
FASTAPI_INTERNAL_URL=http://localhost:8000  # Node uses this to call FastAPI

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development     # "development" or "production"
SECRET_KEY=generate-a-random-32-char-string-here  # JWT signing + AES-256 key — never commit
JWT_EXPIRY=7d

# ─── OAuth ───────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_BASE=http://localhost:3000   # change to production URL in prod
FRONTEND_URL=http://localhost:5173          # OAuth success redirects here after Node callback

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# In dev, Vite proxies /api → localhost:3000, so these can stay unset.
# Set to absolute URLs only for production deployments.
# VITE_API_BASE_URL=https://api.myapp.com/api/v1
# VITE_WS_BASE_URL=wss://api.myapp.com
